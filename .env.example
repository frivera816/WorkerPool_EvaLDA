# Copie este archivo a .env y complete únicamente los datos de conexión.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Parámetros del Worker Pool.
WORKER_COUNT=10
# CLIENT_LIMIT=0 procesa todos los clientes sin evaluación.
CLIENT_LIMIT=10000
BATCH_SIZE=100
DB_QUERY_TIMEOUT=30s

# Estado de persistencia.
# true  -> solo evalúa; no guarda nada en MariaDB (útil para medir velocidad
#          de evaluación sin INSERT).
# false -> evalúa y persiste TODOS los clientes seleccionados. Requiere
#          confirmación explícita; puede insertar miles de registros.
DRY_RUN=true
